library(Matrix)
library(phonTools)
library(QZ)
library(purrr)
library(matrixStats)
library(complexplus)
library(psych)
library(pracma)
library(hawkes)
library(latex2exp)
library(igraph)
library(HDSpectralEstimation)
# Data loading and tuned parameter values
model1_times <- readRDS("~/luna/Regularised_Spectral_Estimation/Section 4/Simulated_Trial_Times/T=200/model1_times.RDS")
#model1_times_50 <- readRDS("~/luna/Regularised_Spectral_Estimation/Section 4/Simulated_Trial_Times/T=200/model1_times_50.RDS")
t12 = model1_times$t12
library(doParallel)
library(doRNG)
cl <- makeCluster(4)
start <- Sys.time()
registerDoParallel(cl)
registerDoRNG(seed = 2)
res <- foreach(j=t12, .packages = c("Matrix","phonTools", "QZ", "purrr", "matrixStats", "complexplus",
"psych", "pracma", "hawkes", "HDSpectralEstimation")) %dopar%{
Max_iter = 1000;
n.trials = 10;n.stream = 12; Big_T = 200; freq = 0.0628
p=n.stream
lambda <- sqrt(log(p)/n.trials) #lams_MSE[1]
S_hat = periodogram(j, freq, Big_T)
res = G_lasso(n.stream, lambda, S_hat, Max_iter)
theta = res$theta
T_hat = 2*theta - theta%*%S_hat%*%theta
sigma = matrix(NA, p, p)
for(i in 1:p){
for(j in 1:p){
sigma[i,j] = theta[j,j]*theta[i,i] + theta[i,j]^2
}
}
return(list(theta, T_hat, sigma))
}
end <-Sys.time()
stopCluster(cl)
end-start # approx 4.2seconds
T_hat = map(res, 2)
sigma = map(res,3)
theta = map(res, 1)
sig = unlist(lapply(T_hat, "[", 1, 3))
sig = sqrt(sig)
x = unlist(lapply(T_hat, "[", 1, 3))
MV_spectra = function(omega, alpha, beta,nu, n.stream){
# Usage     - Function to obtain SDM for a multivariate Hawkes process with
#             Exponential decays
#
# Input Parameters:
#
# omega     - Chosen Frequency
# alpha     - P x P Excitation Matrix
# beta      - P x P Decay Matrix
# nu        - 1  x P vector of backgruond intensities
# n.stream  - Number of data streams
#
# Output:
#
# spectra   - SDM at specified frequency omega
# inv_SDM   - Inverse SDM at specified frequency
# D         - Diagonal matrix of rates of each process
img=sqrt(as.complex(-1))
I = diag(1,n.stream, n.stream)
M = (alpha)/beta
D = solve(I-M)
D = D*nu
D = diag(D)
D =diag(D, n.stream,n.stream)
spectra = list();
for(i in 1:length(omega)){
gamma = alpha/(beta+(img*omega[i]))
#gamma_neg = alpha/(beta-(img*omega[i]))
Id = diag(1, n.stream, n.stream)
t1 = solve(Id - gamma)
t2 = solve(Id - H(gamma))
f =  t1 %*% D %*% t2
spectra[[i]] = f/(2*pi)
}
#simple 3x3 example with mixed dependency
inv_sdm = lapply(spectra, solve)
#get pc estimate
pc = lapply(inv_sdm, partial_co)
return(list(spectra=spectra, inv = inv_sdm, D=D, pc = pc))
}
partial_co = function(theta){
# Usage - Function to obtain parital coherence from inverse SDM (either estimated or theoretical)
#
# Input Parameters:
#
# theta - estimate of inverse SDM obtained via ADMM
#
# Output:
#
#   co - partial coherence matrix
#
#get indices to use - so it generalizes to higher dimensions
indexes = which(upper.tri(theta), arr.ind = T) #alpha instead of theta?
index_list = list();
for(i in 1:(length(indexes)/2)){
index_list[[i]] = indexes[i,]
}
co = diag(1, nrow=dim(theta)[1], ncol=dim(theta)[2]);
for(i in 1:length(index_list)){
k = as.numeric(index_list[[i]][1])
j = as.numeric(index_list[[i]][2])
co[k,j] = Mod(-theta[k,j]/sqrt(theta[k,k]*theta[j,j]))^2
}
co[lower.tri(co)] = t(co)[lower.tri(co)] #populate lower triangle
#put diagonals to 0 just so can look at maximum connections
#diag(co)=0
#connections = which(co > sort(co[lower.tri(co)], TRUE)[4], arr.ind = TRUE)
#diag(co)=1
return(co)
}
omega = 0.0628
alpha = matrix(data=c(0,0.6,0,0, 0.4,0,0,0,0.4), byrow = T, nrow=3)
alpha = rep(list(alpha), 12/dim(alpha)[1])
alpha = as.matrix(bdiag(alpha))
beta = matrix(rep(0.83, 12), nrow=12, ncol = 12)
nu=rep(0.2,12)
truth = MV_spectra(omega, alpha, beta, nu, 12)
theta_star= truth$inv[[1]]
t_13 = theta_star[1,3]
t1 = (sqrt(10)/sig)* (x - t_13)
par(mfrow=c(1,1))
hist(Mod(t1)^2, freq = F, ylim =c(0,1))
curve(dexp(x, 1), add=T, col="red")
hist(Re(t1), freq = F, ylim = c(0,1))
hist(Re(t1), freq = F)
par(mfrow=c(1,2))
hist(Re(t1), freq = F)
hist(Im(t1), freq = F)
hist(Re(t1), freq = F, xlim =c(-1.5,1.5))
hist(Im(t1), freq = F, xlim = c(-1.5,1.5))
lines(seq(-1.5,1.5,length.out=100), dnorm(seq(-1.5,1.5, length.out = 100)), col="blue")
par(mfrow=c(1,2))
hist(Re(t1), freq = F, xlim =c(-3,3))
lines(seq(-3,3,length.out=100), dnorm(seq(-3,3, length.out = 100)), col="blue")
hist(Im(t1), freq = F, xlim = c(-1.5,1.5))
hist(Im(t1), freq = F, xlim = c(-3,3))
lines(seq(-3,3,length.out=100), dnorm(seq(-3,3, length.out = 100)), col="blue")
sig = unlist(lapply(T_hat, "[", 1, 2))
sig = sqrt(sig)
x = unlist(lapply(T_hat, "[", 1, 2))
