get_results2 = function(p, model_type){
# Estimation
rmse_s1_50 <- readRDS(paste0("~/Downloads/BAPLA/Simulation_Study/",model_type,"/Refit/",p,"/rmse_50.RDS"))
rmse_s1_zero <- readRDS(paste0("~/Downloads/BAPLA/Simulation_Study/",model_type,"/Refit/",p,"/rmse_zero.RDS"))
AUC_50 <- readRDS(paste0("~/Downloads/BAPLA/Simulation_Study/",model_type,"/Simulations/",p,"/AUC_50.RDS"))
AUC_zero <- readRDS(paste0("~/Downloads/BAPLA/Simulation_Study/",model_type,"/Simulations/",p,"/AUC_zero.RDS"))
# Inference
res_50_s1 <- readRDS(paste0("~/Downloads/BAPLA/Simulation_Study/",model_type,"/Inference/",p,"/res_50_s2.RDS"))
res_zero_s1 <- readRDS(paste0("~/Downloads/BAPLA/Simulation_Study/",model_type,"/Inference/",p,"/res_zero_s2.RDS"))
out_50 = cbind(as.numeric(rmse_s1_50),  as.numeric(AUC_50), as.numeric(res_50_s1[,1]), as.numeric(res_50_s1[,2]), as.numeric(res_50_s1[,3]), as.numeric(res_50_s1[,4]))
out_zero = cbind(as.numeric(rmse_s1_zero),  as.numeric(AUC_zero), as.numeric(res_zero_s1[,1]), as.numeric(res_zero_s1[,2]),
as.numeric(res_zero_s1[,3]), as.numeric(res_zero_s1[,4]))
out = round(rbind(out_50, out_zero),2)
return(out)
}
