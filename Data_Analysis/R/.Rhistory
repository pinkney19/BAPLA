## ggplot version
plot_example_with_cpts <- function(unit_id, time_bins, out_left, out_right, title) {
xs <- time_bins[-length(time_bins)]
data <- data.frame(
Time = xs,
FiringRate = out_left$firing_rate[unit_id, ]
)
p <- ggplot(data, aes(x = Time, y = FiringRate)) +
