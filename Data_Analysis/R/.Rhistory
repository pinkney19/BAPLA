gamma_j = as.vector(gamma_j$beta)
C[j,-j] = (-1)*t(gamma_j)
tau[j] = as.numeric ( ( t(w_j-w_minus_j%*%as.matrix(gamma_j)) %*% as.matrix(w_j) ) /length(y) )
tau2[j] = as.numeric( sigma_hat[j,j] - sigma_hat[j,-j] %*% as.matrix(gamma_j) )
}
tau
tau2
