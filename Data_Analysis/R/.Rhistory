# Load required library
library(ggplot2)
# Simulate example spike train data
set.seed(42)
n_neurons <- 5
t_max <- 2   # seconds
spike_data <- data.frame()
for (neuron in 1:n_neurons) {
n_spikes <- sample(10:25, 1)
spike_times <- sort(runif(n_spikes, 0, t_max))
spike_data <- rbind(spike_data,
data.frame(time = spike_times, neuron = neuron))
}
# Create raster plot
ggplot(spike_data, aes(x = time, y = factor(neuron))) +
geom_segment(aes(xend = time, yend = neuron + 0.4),
lineend = "round", size = 0.6, color = "black") +
labs(
title = "Raster Plot of Simulated Spike Trains",
x = "Time (s)",
y = "Neuron"
) +
theme_minimal(base_size = 14) +
theme(
panel.grid = element_blank(),
axis.title.y = element_text(angle = 0, vjust = 0.5)
)
# Load ggplot2
library(ggplot2)
# Simulate spike times for one neuron (e.g., 1 second recording)
set.seed(1)
t_max <- 1     # recording duration in seconds
n_spikes <- 30 # number of spikes
spike_times <- sort(runif(n_spikes, 0, t_max))
# Create a data frame (each row = one spike)
spikes <- data.frame(time = spike_times, neuron = 1)
# Raster plot (single row of spike marks)
ggplot(spikes, aes(x = time, y = neuron)) +
geom_segment(aes(xend = time, yend = neuron + 0.3),
color = "black", size = 0.8, lineend = "round") +
labs(
title = "Single Neuron Spike Train (Point Process)",
x = "Time (s)",
y = NULL
) +
theme_minimal(base_size = 14) +
theme(
panel.grid = element_blank(),
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
plot.title = element_text(hjust = 0.5)
)
library(ggplot2)
# Simulate spike times
set.seed(1)
t_max <- 1
n_spikes <- 8
spike_times <- sort(runif(n_spikes, 0, t_max))
# Create data frame with labels t_1, t_2, ...
spikes <- data.frame(
time = spike_times,
label = paste0("t", 1:n_spikes)
)
# Plot
ggplot(spikes, aes(x = time, y = 1)) +
# spike marks
geom_segment(aes(xend = time, yend = 1.2),
size = 0.8, color = "black") +
# labels above spikes
geom_text(aes(label = label, y = 1.25),
size = 4, vjust = 0, angle = 0) +
labs(
title = "Spike Train as a Point Process",
x = "Time (s)",
y = NULL
) +
coord_cartesian(ylim = c(0.9, 1.4)) +
theme_minimal(base_size = 14) +
theme(
panel.grid = element_blank(),
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
plot.title = element_text(hjust = 0.5)
)
