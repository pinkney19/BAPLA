get_cluster_summary = function(stage1_res, Hench_neuron_clusters, cluster_names){
# get which edges are non-zero
edges_list = which(stage1_res!=0, arr.ind=T)
# create dataframe with from and to (i.e. directions)
edge_df = data.frame(from  =  Hench_neuron_clusters[edges_list[,1]],
to = Hench_neuron_clusters[edges_list[,2]] )
cluster_mat = matrix(0, nrow =length(cluster_names) , ncol=length(cluster_names), by=T)
rownames(cluster_mat) = cluster_names; colnames(cluster_mat) = rownames(cluster_mat)
for(i in 1:length(edge_df$from)){
from = edge_df$from[i]
to = edge_df$to[i]
cluster_mat[from, to] = cluster_mat[from,to] + 1
}
# order by connectivity
out_degree = rowSums(mat!=0)
in_degree = colSums(mat!=0)
total_degree = out_degree + in_degree
ordered_names = names(sort(total_degree, decreasing = T))
mat_ordered = mat[ordered_names, ordered_names]
return(cluster_mat)
}
mat_v_left = get_cluster_summary(vis_left, Hench_neuron_clusters, cluster_names)
get_cluster_summary = function(stage1_res, Hench_neuron_clusters, cluster_names){
# get which edges are non-zero
edges_list = which(stage1_res!=0, arr.ind=T)
# create dataframe with from and to (i.e. directions)
edge_df = data.frame(from  =  Hench_neuron_clusters[edges_list[,1]],
to = Hench_neuron_clusters[edges_list[,2]] )
cluster_mat = matrix(0, nrow =length(cluster_names) , ncol=length(cluster_names), by=T)
rownames(cluster_mat) = cluster_names; colnames(cluster_mat) = rownames(cluster_mat)
for(i in 1:length(edge_df$from)){
from = edge_df$from[i]
to = edge_df$to[i]
cluster_mat[from, to] = cluster_mat[from,to] + 1
}
# order by connectivity
out_degree = rowSums(cluster_mat!=0)
in_degree = colSums(cluster_mat!=0)
total_degree = out_degree + in_degree
ordered_names = names(sort(total_degree, decreasing = T))
mat_ordered = cluster_mat[ordered_names, ordered_names]
return(list(cluster_mat = cluster_mat, mat_ordered = mat_ordered))
}
