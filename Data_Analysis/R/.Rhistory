calc_firing_rate = function(f, intercept){
fir_rate = list();
for(i in 1:length(f)){
fir_rate[[i]] = f[[i]] + intercept[[i]]
}
rate = lapply(fir_rate, function(x) exp(x)/(1+exp(x))*1000 )
return(rate)
}
