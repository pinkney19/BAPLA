# Function to get results table
get_s2_results = function(p, model_type, inf){
# Estimation
rmse_s1_50 <- readRDS(paste0("~/Downloads/BAPLA/Synthetic_Experiments/",model_type,"/Refit/",p,"/rmse_50.RDS"))
rmse_s1_zero <- readRDS(paste0("~/Downloads/BAPLA/Synthetic_Experiments/",model_type,"/Refit/",p,"/rmse_zero.RDS"))
# mses for intercept
int_mse_50 = readRDS(paste0("~/Downloads/BAPLA/Synthetic_Experiments/",model_type,"/Refit/",p,"/int_mses_50.RDS"))
int_mse_zero = readRDS(paste0("~/Downloads/BAPLA/Synthetic_Experiments/",model_type,"/Refit/",p,"/int_mses_zero.RDS"))
# mses for f
f_mse_50 = readRDS(paste0("~/Downloads/BAPLA/Synthetic_Experiments/",model_type,"/Refit/",p,"/f_mses_50.RDS"))
f_mse_zero = readRDS(paste0("~/Downloads/BAPLA/Synthetic_Experiments/",model_type,"/Refit/",p,"/f_mses_zero.RDS"))
# AUROC
AUC_50 <- readRDS(paste0("~/Downloads/BAPLA/Synthetic_Experiments/",model_type,"/Simulations/",p,"/AUC_50.RDS"))
AUC_zero <- readRDS(paste0("~/Downloads/BAPLA/Synthetic_Experiments/",model_type,"/Simulations/",p,"/AUC_zero.RDS"))
# Inference
if(inf==T){
res_50_s1 <- readRDS(paste0("~/Downloads/BAPLA/Synthetic_Experiments/",model_type,"/Inference/",p,"/stage2/res_50_s2.RDS"))
res_zero_s1 <- readRDS(paste0("~/Downloads/BAPLA/Synthetic_Experiments/",model_type,"/Inference/",p,"/stage2/res_zero_s2.RDS"))
}
if(inf==F){
res_50_s1 = matrix(NA, 4, 4)
res_zero_s1 = matrix(NA, 4, 4)
}
out_50 = cbind(as.numeric(rmse_s1_50), as.numeric(int_mse_50), as.numeric(f_mse_50), as.numeric(AUC_50),
as.numeric(res_50_s1[,1]), as.numeric(res_50_s1[,2]), as.numeric(res_50_s1[,3]), as.numeric(res_50_s1[,4]))
out_zero = cbind(as.numeric(rmse_s1_zero), as.numeric(int_mse_zero), as.numeric(f_mse_zero), as.numeric(AUC_zero), as.numeric(res_zero_s1[,1]),
as.numeric(res_zero_s1[,2]), as.numeric(res_zero_s1[,3]), as.numeric(res_zero_s1[,4]))
out = round(rbind(out_50, out_zero),2)
return(out)
}
