setwd("~/Downloads/BAPLA/Synthetic_Experiments")
source("BAPLA_Functions.R")
n_samp = seq(1,100)
p = 10;
true_beta <- readRDS("~/Downloads/BAPLA/Synthetic_Experiments/CG/beta_10.RDS")
# Read 50/50 data from STORM
out_50_1000_desparsified <- readRDS("~/luna/BAPLA/Synthetic_Experiments/CG/Inference/10/new_stage1/out_50_1000_desparsified.RDS")
out_50_2000_desparsified <- readRDS("~/luna/BAPLA/Synthetic_Experiments/CG/Inference/10/new_stage1/out_50_2000_desparsified.RDS")
out_50_5000_desparsified <- readRDS("~/luna/BAPLA/Synthetic_Experiments/CG/Inference/10/new_stage1/out_50_5000_desparsified.RDS")
out_50_10000_desparsified <- readRDS("~/luna/BAPLA/Synthetic_Experiments/CG/Inference/10/new_stage1/out_50_10000_desparsified.RDS")
# Results for 50/50 data
out50 = list(out_50_1000_desparsified, out_50_2000_desparsified, out_50_5000_desparsified, out_50_10000_desparsified)
res_50_s1 = Format_results(true_beta, out50, n_samp, p, "stage 1 - 50")
coverage = function(active, true_beta, out_storm, n_samp, unit_id){
# select results of interest
b = length(n_samp)*unit_id #i.e. for unit_id = 1 b = 100
if(unit_id==1){
res = out_storm[1:b] #i.e. samples 1-100 for unit 1
}
if(unit_id!=1){
res = out_storm[((b-length(n_samp))+1):b]
}
true_beta = true_beta[unit_id,]
if(active==T){
s = which(true_beta!=0) # active set#
}
if(active==F){
s_c = which(true_beta==0)
s = s_c
}
lower = map(res, 3)
upper = map(res, 4)
if(sum(s)!=0){
truth = true_beta[s]
s_count = rep(0,length(truth)); s_count = rep(list(s_count), length(n_samp))
length_ci = rep(0, length(truth)); length_ci = rep(list(length_ci), length(n_samp))
for(i in 1:length(n_samp)){
lower_vals = lower[[i]][s]
upper_vals = upper[[i]][s]
for(j in 1:length(truth)){
if(truth[j]>lower_vals[j] & truth[j]<upper_vals[j]){s_count[[i]][j] = s_count[[i]][j] + 1}
}
# get lengths of CI
length_ci[[i]] = upper_vals-lower_vals
}
totals = unlist(lapply(s_count, sum))
avg_cov = sum(totals)/(length(n_samp)*length(s))
# lengths
t_length = unlist(lapply(length_ci, sum))
av_length = sum(t_length)/ (length(n_samp)*length(s))
}
# if no values in the active set
if(sum(s)==0){
avg_cov = av_length = NA
}
return(list(cov = avg_cov, len = av_length))
}
res_50_s1 = Format_results(true_beta, out50, n_samp, p, "stage 1 - 50")
par(mfrow= c(1,1))
image(true_beta)
Format_results()
Format_results
get_avg_cov()
get_avg_cov
