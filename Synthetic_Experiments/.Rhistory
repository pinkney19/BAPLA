# plots
# plots
mu_unimodal = function(t, a, b1, b2, delta){
#' Function to calculate unimodal backgrund rate
exp(a+b1*cos(2*pi*t/delta)+b2*sin(2*pi*t/delta)) #+
#b3*cos(4*pi*t/delta)+b4*sin(4*pi*t/delta))
}
b=-3;c=0;
a = log(0.05)+b;
x_grid = seq(1, delta, length.out =1000)
f_orig = mu_unimodal(x_grid, a, b, c, delta)
plot(x_grid, f_orig, type='l', ylab=expression(mu(t)),xlab="Time" )
shifts = c(-60,-120,-180,-240,-300); res_shift = list();new_b=list();
#shifts = c(180,120,60,-60,-120,-180,-240,-300)
new_c=list(); f=list();weighted_dist = NULL;hell_dist = NULL;
for(i in 1:length(shifts)){
res_shift = shift_coefs(a, b,c ,shifts[i], delta)
new_b[[i]] = res_shift$b
new_c[[i]] = res_shift$c
f[[i]]  = res_shift$fa
weighted_dist[i] = sqrt(mean((f_orig-f[[i]])^2))
hell_dist[i] = hellinger(f_orig, f[[i]])
lines(x_grid, f[[i]], col=i+1)
}
bs = unlist(map(new_b,1))
cs = unlist(map(new_c,1))
