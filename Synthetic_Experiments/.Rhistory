calculate_TPr = function(out, penalty0){
TPr=NULL;
for(k in 1:length(penalty0)){
ind = which(out$dif_cost_null >=penalty0[k])
TPr[k] = length(ind)/100
}
return(TPr)
}
plot(FPr, calculate_TPr(out_5), type='l')
plot(FPr, calculate_TPr(out_5, penalty0), type='l')
