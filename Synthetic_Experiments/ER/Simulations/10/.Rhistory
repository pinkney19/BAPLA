est_intercept = function(out,p, truth){
# get intercept estimate
ints = map(out, 2) #list of 100
mse = NULL; se = NULL;
for(i in 1:p){
beta_0s = unlist(map(ints, i))
mse[i] = mean( (beta_0s-truth)^2 )
se[i] = std_err( (beta_0s-truth)^2 )
}
return(list(mse = mean(mse), err = mean(se)))
}
