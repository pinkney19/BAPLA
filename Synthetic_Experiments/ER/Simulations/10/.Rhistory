plot_f_cis_gamma <- function(f, unit_id, title, N) {
check <- list_to_matrix(f)
median_vals <- colQuantiles(check, probs = 0.5)
upper_vals <- colQuantiles(check, probs = 0.975)
lower_vals <- colQuantiles(check, probs = 0.025)
xs <- dgamma(seq(0, 1, length.out=N-1), shape = 2, scale =  0.05)-1
data <- data.frame(
t = 1:length(median_vals),
median = median_vals,
upper = upper_vals,
lower = lower_vals,
xs = xs
)
ggplot(data, aes(x = t/N)) +
geom_line(aes(y = median), color = "black") +
geom_line(aes(y = upper), color = "red") +
geom_line(aes(y = lower), color = "red") +
geom_line(aes(y = xs), color = "blue", linetype = "dashed", size = 1) +
labs(x = "t", y = expression(hat(f)(t)), title = title) +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5)) +
scale_y_continuous(limits = c(-5, 9)) +
theme(legend.position = "topright") +
guides(color = guide_legend(override.aes = list(linetype = c("solid", "solid", "dashed"), size = c(1, 1, 1))))
}
f1 = plot_f_cis_gamma(f_hat_50_1000, 1, "n = 1000",1000)
f2 = plot_f_cis_gamma(f_hat_50_2000, 1, "n = 2000",2000)
f3 = plot_f_cis_gamma(f_hat_50_5000, 1, "n = 5000",5000)
f4 = plot_f_cis_gamma(f_hat_50_10000, 1, "n = 10000",10000)
ggarrange(f1,f2,f3,f4, ncol=4, common.legend =T)
f_hat_zero_1000 = get_f(out_zero_1000, 10, 999, unit_id = 1)
f_hat_zero_2000 = get_f(out_zero_2000, 10, 1999, unit_id = 1)
f_hat_zero_5000 = get_f(out_zero_5000, 10, 4999, unit_id = 1)
ggarrange(f5,f6,f7,f8, ncol=4, common.legend =T)
f5 = plot_f_cis_gamma(f_hat_zero_1000, 1, "n = 1000",1000)
f6 = plot_f_cis_gamma(f_hat_zero_2000, 1, "n = 2000",2000)
f7 = plot_f_cis_gamma(f_hat_zero_5000, 1, "n = 5000",5000)
f8 = plot_f_cis_gamma(f_hat_zero_10000, 1, "n = 10000",10000)
ggarrange(f5,f6,f7,f8, ncol=4, common.legend =T)
plot_f_cis_gamma <- function(f, unit_id, title, N) {
check <- list_to_matrix(f)
median_vals <- colQuantiles(check, probs = 0.5)
upper_vals <- colQuantiles(check, probs = 0.975)
lower_vals <- colQuantiles(check, probs = 0.025)
xs <- dgamma(seq(0, 1, length.out=N-1), shape = 2, scale =  0.05)-1
data <- data.frame(
t = 1:length(median_vals),
median = median_vals,
upper = upper_vals,
lower = lower_vals,
xs = xs
)
ggplot(data, aes(x = t/N)) +
geom_line(aes(y = median), color = "black") +
geom_line(aes(y = upper), color = "red") +
geom_line(aes(y = lower), color = "red") +
geom_line(aes(y = xs), color = "blue", linetype = "dashed", size = 1) +
labs(x = "t", y = expression(hat(f)(t)), title = title) +
theme_minimal() +
theme(plot.title = element_text(hjust = 0.5)) +
scale_y_continuous(limits = c(-5, 12)) +
theme(legend.position = "topright") +
guides(color = guide_legend(override.aes = list(linetype = c("solid", "solid", "dashed"), size = c(1, 1, 1))))
}
