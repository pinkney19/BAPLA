est_intercept = function(out,p, truth){
# get intercept estimate
ints = map(out, 2) #list of 100
mse = NULL;
for(i in 1:p){
beta_0s = unlist(map(ints, 1))
mse[i] = mean( (beta_0s-truth)^2 )
}
}
