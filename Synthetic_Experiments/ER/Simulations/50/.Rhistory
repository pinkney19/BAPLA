out_50_2000 <- readRDS("~/Downloads/BAPLA/Synthetic_Experiments/CG/Simulations/50/out_50_2000.RDS")
out_50_5000 <- readRDS("~/Downloads/BAPLA/Synthetic_Experiments/CG/Simulations/50/out_50_5000.RDS")
