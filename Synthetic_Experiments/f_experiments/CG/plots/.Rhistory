x_AUC[[i]] = c(AUC0[[i]], m3$AUC[[i]], m5$AUC[[i]], m10$AUC[[i]],m15$AUC[[i]], m20$AUC[[i]],
m25$AUC[[i]], m30$AUC[[i]],m35$AUC[[i]], m40$AUC[[i]])
}
