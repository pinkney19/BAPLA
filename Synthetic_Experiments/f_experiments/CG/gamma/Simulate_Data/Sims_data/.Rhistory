compute_diagnostics = function(res_all, B){
upper_triangle = lapply(res_all, function(x) x[upper.tri(x)])
skewness =NULL; excess_kurt = NULL;
for(i in 1:lengths(upper_triangle)[1]){
cor = unlist(map(upper_triangle, i))
boot_means = NULL;
for(b in 1:B){
sample_b = sample(cor, size = length(cor), replace = T)
boot_means[b] = mean(sample_b)
}
skewness[i] = skewness(boot_means)
excess_kurt[i] = kurtosis(boot_means)-3
}
return(skewness, excess_kurt)
}
check = compute_diagnostics(all_corr)
check = compute_diagnostics(all_corr, 5000)
compute_diagnostics = function(res_all, B){
upper_triangle = lapply(res_all, function(x) x[upper.tri(x)])
skewness =NULL; excess_kurt = NULL;
for(i in 1:lengths(upper_triangle)[1]){
print(i)
cor = unlist(map(upper_triangle, i))
boot_means = NULL;
for(b in 1:B){
sample_b = sample(cor, size = length(cor), replace = T)
boot_means[b] = mean(sample_b)
}
skewness[i] = skewness(boot_means)
excess_kurt[i] = kurtosis(boot_means)-3
}
return(list(skew=skewness, kurt = excess_kurt))
}
check = compute_diagnostics(all_corr, 5000)
check$skew
which(check$skew>0.5)
which(check$kurt>``)
which(check$kurt>1)
