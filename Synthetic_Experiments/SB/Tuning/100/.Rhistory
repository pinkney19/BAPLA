res_vis_right =  combine_estimates(beta_hat_vis_right, sorted_ids, p_est = 48, id_vec = id_vis)
res_wheel_right = combine_estimates(beta_hat_wheel_right, sorted_ids, p_est = 56, id_vec = id_wheel)
