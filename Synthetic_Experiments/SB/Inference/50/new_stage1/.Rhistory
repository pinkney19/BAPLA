get_node_degree(vis_left)
get_node_degree = function(matrix){
# Exclude self-loops (diagonal)
diag(matrix) <- 0
# Degree
# matrix != 0 -> creates true/false for each row
degrees <- rowSums(matrix != 0)
return(max(degrees))
}
get_node_degree(vis_left)
