y = expression(D ~ tilde(Lambda)),
title = ""
) +
theme_minimal(base_size = 15) +
ylim(0, max(U_out) + 0.7) +
scale_shape_manual(values = c(1, 17)) +
scale_color_manual(values = c("black", "navy")) +
theme(legend.position = "top")
# Plot
ggplot(data, aes(x = times, y = lambdas)) +
geom_line(size = 0.5, color = "black") +
geom_point(data = accepted, aes(x = P, y = U_out), color = "black", shape = 1, size = 2) +
geom_point(data = accepted, aes(x = P, y = 0), color = "black", shape = 15, size = 2) +
geom_segment(data = accepted, aes(x = P, xend = P, y = 0, yend = U_out), color = "grey", linetype = "dashed") +
geom_point(data = not_accepted_data, aes(x = P, y = U_out), color = "navy", shape = 17, size = 2) +
geom_segment(aes(x = 0, xend = t_out[1], y = M_out[1], yend = M_out[1]), color = "deepskyblue", size = 1) +
geom_segment(data = data.frame(t_out = t_out, M_out = M_out),
aes(x = t_out, xend = lead(t_out), y = lead(M_out), yend = lead(M_out)),
color = "deepskyblue", size = 0.51) +
labs(
x = "t",
y = expression(D ~ tilde(Lambda)),
title = ""
) +
theme_minimal(base_size = 12) +
ylim(0, max(U_out) + 0.7) +
scale_shape_manual(values = c(1, 17)) +
scale_color_manual(values = c("black", "navy")) +
theme(legend.position = "top")
library(purrr)
setwd("~/Downloads/BAPLA/Synthetic_Experiments")
source("BAPLA_Functions.R")
p = 100;
beta <- readRDS("~/Downloads/BAPLA/Synthetic_Experiments/CG/beta_100.RDS")
# load simulation results -------------------------------------------------
out_50_1000 <- readRDS("~/Downloads/BAPLA/Synthetic_Experiments/CG/Simulations/100/out_50_1000.RDS")
out_50_2000 <- readRDS("~/Downloads/BAPLA/Synthetic_Experiments/CG/Simulations/100/out_50_2000.RDS")
out_zero_1000 <- readRDS("~/Downloads/BAPLA/Synthetic_Experiments/CG/Simulations/100/out_zero_1000.RDS")
out_zero_2000 <- readRDS("~/Downloads/BAPLA/Synthetic_Experiments/CG/Simulations/100/out_zero_2000.RDS")
out_zero_5000 <- readRDS("~/Downloads/BAPLA/Synthetic_Experiments/CG/Simulations/100/out_zero_5000.RDS")
out_zero_10000 <- readRDS("~/Downloads/BAPLA/Synthetic_Experiments/CG/Simulations/100/out_zero_10000.RDS")
# new way -----------------------------------------------------------------
library(pROC)
library(pracma)
res_zero_1000 =metrics_new(out_zero_1000, beta, 1e-5)
res_zero_2000 =metrics_new(out_zero_2000, beta,1e-5)
res_zero_5000 =metrics_new(out_zero_5000, beta,1e-5)
res_zero_10000 =metrics_new(out_zero_10000, beta,1e-5)
RMSEs_zero = c(res_zero_1000$av_mse, res_zero_2000$av_mse,res_zero_5000$av_mse, res_zero_10000$av_mse)
ses_zero = c(res_zero_1000$se, res_zero_2000$se,res_zero_5000$se, res_zero_10000$se)
aurocs_zero = c(res_zero_1000$av_AUC, res_zero_2000$av_AUC,res_zero_5000$av_AUC,  res_zero_10000$av_AUC)
aurocs_se_zero = c(res_zero_1000$auc_se, res_zero_2000$auc_se,res_zero_5000$auc_se, res_zero_10000$auc_se)
setwd("~/Downloads/BAPLA/Synthetic_Experiments/CG/Simulations/100")
saveRDS(RMSEs_zero, "rmse_zero.RDS")
saveRDS(ses_zero,"ses_zero.RDS")
saveRDS(aurocs_zero, "AUC_zero.RDS")
saveRDS(aurocs_se_zero, "AUC_se_zero.RDS")
aurocs_zero
