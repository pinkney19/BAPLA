res = all_res[[i]]
times = map(res, 6)
avg_time[i] = mean(unlist(times)) # 0.69 seconds
iter = map(res, 7)
avg_iter[[i]] = Reduce("+", iter)/length(iter)
}
iter_av = sapply(avg_iter, mean)
return(list(iter = iter_av, time = avg_time))
}
