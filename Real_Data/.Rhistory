idx = c(rep(1,100), rep(2, 100), rep(3,100), rep(4,100), rep(5,100), rep(6,100), rep(7,100),
rep(8,100), rep(9,100), rep(10,100) )
list_of_trips <- Map(list, data, unlist(beta_debs, recursive = F), idx)
