boxplot(df_50_2000, main = paste0(model_type, " - 2000"), ylim =c(0.85, 0.99))
boxplot(df_50_5000, main = paste0(model_type, " - 5000"), ylim =c(0.85, 0.99))
boxplot(df_50_10000, main = paste0(model_type, " - 10000"), ylim =c(0.85, 0.99))
